<Page
  x:Class="HalcyonRecords.SeedDataGenerator.Views.ArtistListPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shared="using:HalcyonRecords.Shared"
>
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Button Grid.Row="0" Content="Add Artist" Command="{x:Bind ViewModel.AddArtistCommand}" />

    <ListView
      Grid.Row="1"
      ItemsSource="{x:Bind ViewModel.Artists}"
      IsItemClickEnabled="True"
      ItemClick="OnArtistItemClick"
      SelectionMode="None"
    >
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="shared:ArtistSeedEntry">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind Origin}" Opacity="0.7" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
