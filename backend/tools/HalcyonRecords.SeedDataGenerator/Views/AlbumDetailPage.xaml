<Page
  x:Class="HalcyonRecords.SeedDataGenerator.Views.AlbumDetailPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HalcyonRecords.SeedDataGenerator"
>
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
      <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}" HorizontalAlignment="Left" />

      <TextBlock
        Text="{x:Bind ViewModel.Album.Title, Mode=OneWay}"
        FontSize="24"
        FontWeight="SemiBold"
      />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Artist(s):" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.ArtistNames, Mode=OneWay}" TextWrapping="Wrap" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Released:" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind local:BindingHelpers.FormatDate(ViewModel.Album.ReleaseDate), Mode=OneWay}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Label:" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind local:BindingHelpers.OrPlaceholder(ViewModel.Album.Label, 'Unknown'), Mode=OneWay}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Genre(s):" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.GenreNames, Mode=OneWay}" TextWrapping="Wrap" />
      </StackPanel>

      <TextBlock Text="Description" FontWeight="SemiBold" />
      <TextBlock
        Text="{x:Bind local:BindingHelpers.OrPlaceholder(ViewModel.Album.Description, 'No description available.'), Mode=OneWay}"
        TextWrapping="Wrap"
      />

      <TextBlock Text="Stock and pricing" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="In stock:" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.Album.UnitsInStock, Mode=OneWay}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Price:" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind local:BindingHelpers.FormatPrice(ViewModel.Album.PriceInPence), Mode=OneWay}" />
      </StackPanel>
      <StackPanel
        Orientation="Horizontal"
        Spacing="8"
        Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.Album.OriginalPriceInPence), Mode=OneWay}"
      >
        <TextBlock Text="Was:" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind local:BindingHelpers.FormatPrice(ViewModel.Album.OriginalPriceInPence), Mode=OneWay}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock
          Text="New"
          Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.Album.IsNew), Mode=OneWay}"
        />
        <TextBlock
          Text="Staff Pick"
          Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.Album.IsStaffPick), Mode=OneWay}"
        />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Edit" Command="{x:Bind ViewModel.EditCommand}" />
        <Button Content="Delete" Click="OnDeleteClick" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
