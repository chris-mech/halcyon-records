<Page
  x:Class="HalcyonRecords.SeedDataGenerator.Views.GenreListPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:shared="using:HalcyonRecords.Shared"
>
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Button Grid.Row="0" Content="Add Genre" Command="{x:Bind ViewModel.AddGenreCommand}" />

    <ListView
      Grid.Row="1"
      ItemsSource="{x:Bind ViewModel.Genres}"
      IsItemClickEnabled="True"
      ItemClick="OnGenreItemClick"
      SelectionMode="None"
    >
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="shared:GenreSeedEntry">
          <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
