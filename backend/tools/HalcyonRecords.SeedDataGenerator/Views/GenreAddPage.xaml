<Page
  x:Class="HalcyonRecords.SeedDataGenerator.Views.GenreAddPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <StackPanel Padding="24" Spacing="16" MaxWidth="400" HorizontalAlignment="Left">
    <Button
      Content="Cancel"
      Command="{x:Bind ViewModel.CancelCommand}"
      HorizontalAlignment="Left"
    />

    <TextBlock Text="Genre" FontWeight="SemiBold" />
    <ComboBox
      ItemsSource="{x:Bind ViewModel.AvailableGenreNames}"
      SelectedItem="{x:Bind ViewModel.SelectedGenreName, Mode=TwoWay}"
      PlaceholderText="Choose a genre"
      HorizontalAlignment="Stretch"
    />

    <Button Content="Add" Command="{x:Bind ViewModel.AddCommand}" HorizontalAlignment="Left" />
  </StackPanel>
</Page>
