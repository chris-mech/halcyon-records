<Page
  x:Class="HalcyonRecords.SeedDataGenerator.Views.ArtistEditPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HalcyonRecords.SeedDataGenerator"
>
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
      <Button
        Content="Cancel"
        Command="{x:Bind ViewModel.CancelCommand}"
        HorizontalAlignment="Left"
      />

      <TextBlock Text="Name" FontWeight="SemiBold" />
      <TextBox Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Text="Type" FontWeight="SemiBold" />
      <ComboBox
        ItemsSource="{x:Bind ViewModel.TypeOptions}"
        SelectedItem="{x:Bind ViewModel.TypeSelection, Mode=TwoWay}"
      />

      <TextBlock Text="Origin" FontWeight="SemiBold" />
      <TextBox Text="{x:Bind ViewModel.Origin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Text="Since (year)" FontWeight="SemiBold" />
      <TextBox
        x:Name="SinceYearBox"
        Width="120"
        MaxLength="4"
        HorizontalAlignment="Left"
        Text="{x:Bind ViewModel.SinceYearInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        BeforeTextChanging="OnSinceYearBeforeTextChanging"
      />

      <TextBlock Text="Bio" FontWeight="SemiBold" />
      <TextBox
        Text="{x:Bind ViewModel.Bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        TextWrapping="Wrap"
        AcceptsReturn="True"
        Height="120"
      />

      <TextBlock Text="Image URL" FontWeight="SemiBold" />
      <TextBox Text="{x:Bind ViewModel.ImageUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

      <Button
        Content="Refresh from online sources"
        Command="{x:Bind ViewModel.RefreshCommand}"
        HorizontalAlignment="Left"
      />

      <TextBlock
        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Foreground="Red"
        TextWrapping="Wrap"
        Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.ErrorMessage), Mode=OneWay}"
      />

      <ProgressRing
        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.IsBusy), Mode=OneWay}"
        HorizontalAlignment="Left"
      />

      <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Left" />
    </StackPanel>
  </ScrollViewer>
</Page>
