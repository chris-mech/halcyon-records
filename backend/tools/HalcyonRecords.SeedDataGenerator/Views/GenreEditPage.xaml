<Page
  x:Class="HalcyonRecords.SeedDataGenerator.Views.GenreEditPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <StackPanel Padding="24" Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
    <Button
      Content="Cancel"
      Command="{x:Bind ViewModel.CancelCommand}"
      HorizontalAlignment="Left"
    />

    <TextBlock Text="Name" FontWeight="SemiBold" />
    <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Opacity="0.7" />

    <TextBlock Text="Description" FontWeight="SemiBold" />
    <TextBox
      Text="{x:Bind ViewModel.Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
      TextWrapping="Wrap"
      AcceptsReturn="True"
      Height="120"
    />

    <Button Content="Save" Command="{x:Bind ViewModel.SaveCommand}" HorizontalAlignment="Left" />
  </StackPanel>
</Page>
