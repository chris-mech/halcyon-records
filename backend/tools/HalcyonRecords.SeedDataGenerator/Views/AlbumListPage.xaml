<Page
  x:Class="HalcyonRecords.SeedDataGenerator.Views.AlbumListPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HalcyonRecords.SeedDataGenerator"
  xmlns:shared="using:HalcyonRecords.Shared"
>
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Button Grid.Row="0" Content="Add Album" Command="{x:Bind ViewModel.AddAlbumCommand}" />

    <ListView
      Grid.Row="1"
      ItemsSource="{x:Bind ViewModel.Albums}"
      IsItemClickEnabled="True"
      ItemClick="OnAlbumItemClick"
      SelectionMode="None"
    >
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="shared:AlbumSeedEntry">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
            <TextBlock Text="{x:Bind local:BindingHelpers.FormatYear(ReleaseDate)}" Opacity="0.7" />
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
