<Page
  x:Class="HalcyonRecords.SeedDataGenerator.Views.AlbumAddPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:HalcyonRecords.SeedDataGenerator"
  xmlns:musicBrainz="using:HalcyonRecords.SeedDataGenerator.Core.MusicBrainz"
  xmlns:discogs="using:HalcyonRecords.SeedDataGenerator.Core.Discogs"
>
  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
      <Button
        Content="Cancel"
        Command="{x:Bind ViewModel.CancelCommand}"
        HorizontalAlignment="Left"
      />

      <TextBlock Text="Add by MusicBrainz ID" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox
          Width="360"
          Text="{x:Bind ViewModel.MbidInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          PlaceholderText="MusicBrainz release ID"
          KeyDown="OnMbidInputKeyDown"
        />
        <Button Content="Look Up" Command="{x:Bind ViewModel.LookUpMbidCommand}" />
      </StackPanel>

      <TextBlock Text="Or search by artist and title" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox
          Width="170"
          Text="{x:Bind ViewModel.SearchArtistName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          PlaceholderText="Artist (optional)"
          KeyDown="OnSearchKeyDown"
        />
        <TextBox
          Width="170"
          Text="{x:Bind ViewModel.SearchReleaseTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
          PlaceholderText="Release title"
          KeyDown="OnSearchKeyDown"
        />
        <Button Content="Search" Command="{x:Bind ViewModel.SearchCommand}" />
      </StackPanel>

      <ListView
        ItemsSource="{x:Bind ViewModel.SearchResults}"
        IsItemClickEnabled="True"
        ItemClick="OnSearchResultClick"
        SelectionMode="None"
        Visibility="{x:Bind local:BindingHelpers.ToVisibilityFromCount(ViewModel.SearchResults.Count), Mode=OneWay}"
      >
        <ListView.ItemTemplate>
          <DataTemplate x:DataType="musicBrainz:MusicBrainzReleaseSearchResult">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
              <TextBlock
                Text="{x:Bind local:BindingHelpers.FormatArtistCredit(ArtistCredit)}"
                Opacity="0.7"
              />
              <TextBlock Text="{x:Bind Date}" Opacity="0.7" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <TextBlock
        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
        Foreground="Red"
        TextWrapping="Wrap"
        Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.ErrorMessage), Mode=OneWay}"
      />

      <ProgressRing
        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
        Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.IsBusy), Mode=OneWay}"
        HorizontalAlignment="Left"
      />

      <StackPanel
        x:Name="PreviewPanel"
        Spacing="8"
        Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.Plan), Mode=OneWay}"
      >
        <TextBlock Text="Preview" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.PlanTitle, Mode=OneWay}" FontSize="18" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Released:" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.PlanReleaseDate, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Label:" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.PlanLabel, Mode=OneWay}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Artist(s):" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.PlanArtistCredits, Mode=OneWay}" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock
          Text="{x:Bind ViewModel.PlanNewArtists, Mode=OneWay}"
          Opacity="0.7"
          TextWrapping="Wrap"
          Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.PlanNewArtists), Mode=OneWay}"
        />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Genre(s):" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind ViewModel.PlanGenres, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
          Text="Choose the matching Discogs release to resolve genres:"
          FontWeight="SemiBold"
          Visibility="{x:Bind local:BindingHelpers.ToVisibilityFromCount(ViewModel.DiscogsCandidates.Count), Mode=OneWay}"
        />
        <ListView
          ItemsSource="{x:Bind ViewModel.DiscogsCandidates}"
          IsItemClickEnabled="True"
          ItemClick="OnDiscogsCandidateClick"
          SelectionMode="None"
          Visibility="{x:Bind local:BindingHelpers.ToVisibilityFromCount(ViewModel.DiscogsCandidates.Count), Mode=OneWay}"
        >
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="discogs:DiscogsSearchResult">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind local:BindingHelpers.FormatList(Genre)}" Opacity="0.7" />
                <TextBlock
                  Text="{x:Bind local:BindingHelpers.FormatCommunity(Community)}"
                  Opacity="0.7"
                />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <TextBlock Text="Description" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind ViewModel.PlanDescription, Mode=OneWay}" TextWrapping="Wrap" />

        <TextBlock Text="Stock and pricing" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox
            Width="100"
            Text="{x:Bind ViewModel.UnitsInStockInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="0"
            MaxLength="6"
            BeforeTextChanging="OnUnitsInStockBeforeTextChanging"
            Header="Units in stock"
          />
          <TextBox
            Width="100"
            Text="{x:Bind ViewModel.PriceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="0.00"
            MaxLength="8"
            BeforeTextChanging="OnPriceBeforeTextChanging"
            Header="Price (£)"
          />
          <TextBox
            Width="100"
            Text="{x:Bind ViewModel.OriginalPriceInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="0.00"
            MaxLength="8"
            BeforeTextChanging="OnPriceBeforeTextChanging"
            Header="Was (£, optional)"
          />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="16">
          <CheckBox Content="New" IsChecked="{x:Bind ViewModel.IsNew, Mode=TwoWay}" />
          <CheckBox Content="Staff Pick" IsChecked="{x:Bind ViewModel.IsStaffPick, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock
          Text="{x:Bind ViewModel.CommitErrorMessage, Mode=OneWay}"
          Foreground="Red"
          TextWrapping="Wrap"
          Visibility="{x:Bind local:BindingHelpers.ToVisibility(ViewModel.CommitErrorMessage), Mode=OneWay}"
        />
        <Button Content="Add Album" Command="{x:Bind ViewModel.CommitCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Page>
