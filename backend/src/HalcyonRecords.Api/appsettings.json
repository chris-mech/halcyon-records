{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Caching": {
    "TtlSeconds": 60
  },
  "MeilisearchIndex": {
    "IndexName": "albums"
  },
  "Search": {
    "BestMatchRankingScoreThreshold": 0.5,
    "SuggestionLimit": 4,
    "SuggestedTermCount": 3
  },
  "RelatedAlbums": {
    "MaxResults": 4
  }
}