{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "Kestrel": {
    "Certificates": {
      "Default": {
        "Path": "certs/kestrel.pfx"
      }
    }
  }
}